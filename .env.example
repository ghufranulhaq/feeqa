APP_NAME=feeqa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=feeqa
DB_USERNAME=feeqa
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@feeqa.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PATH=/_mail

# External providers — .env only (constitution §5.1). Every one has a `fake`
# driver; production must not use `fake` for any of these (enforced by
# App\Support\Environment::assertProductionIsSafe(), plan D26).
AI_DRIVER=fake
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_FAST=
AI_TIMEOUT=60
AI_MAX_TOKENS=4000

VERIFICATION_EXTRACTOR=fake
OCR_LANGUAGES=eng

TRANSCRIPTION_DRIVER=fake

MALWARE_SCANNER=fake
CLAMAV_HOST=

BILLING_DRIVER=fake

# Comma-separated CIDR/IP list. Only enforced in production (plan D7) —
# ignored everywhere else, so leave blank in local/demo.
STAFF_ALLOWED_IPS=

# Blank = storage/app/signing/keys.json. Run `php artisan signing:generate-key`
# once to create the first keypair; SIGNING_ACTIVE_KID can stay blank to use
# whichever key was generated first, or pin a specific one after rotating.
SIGNING_KEYS_PATH=
SIGNING_ACTIVE_KID=

VITE_APP_NAME="${APP_NAME}"
